# Telegram Bot配置
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# 管理员用户ID（多个用逗号分隔）
ADMIN_USER_IDS=123456789,987654321

# 数据库配置
DATABASE_PATH=data/bot.db

# API服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# TGAPI接码配置 ⭐ 重要
TGAPI_BASE_URL=https://api.yourdomain.com
# 如果使用HTTP: TGAPI_BASE_URL=http://yourdomain.com:8000
# 本地测试: TGAPI_BASE_URL=http://localhost:8000
# 此URL用于生成接码链接，客户端将访问: {TGAPI_BASE_URL}/api/code/{token}

TGAPI_DEFAULT_EXPIRE_HOURS=24
TGAPI_DEFAULT_MAX_LOGIN=-1

# ==================== Web管理后台配置 ⭐ 重要 ====================

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ⚠️ 生产环境请立即修改默认密码！

# Session密钥（用于加密Session）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your_secret_key_here_change_in_production

# Session过期时间（小时）
SESSION_TIMEOUT_HOURS=24

# 管理后台访问地址
# 访问: http://yourdomain.com:8000/admin
# 本地: http://localhost:8000/admin

# 许可证配置（用于反盗版）
LICENSE_MAX_DEVICES=3

# ==================== 数据库配置（高级） ====================

# 数据库类型: sqlite 或 mysql
DATABASE_TYPE=sqlite

# MySQL配置（生产环境推荐）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tgbot
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=tgbot_manager
MYSQL_CHARSET=utf8mb4

# Redis配置（可选，用于缓存加速）
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 代理配置（可选） ====================

# 是否启用代理（false = 直连模式）
PROXY_ENABLED=false

# 代理通过管理后台动态添加，无需在此配置
# 访问管理后台 → 代理管理 → 添加代理

# ==================== 备份配置 ====================

BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
