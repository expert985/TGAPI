# ==================== Telegram Bot配置 ====================

# 单Bot模式（传统模式）
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# 管理员用户ID（多个用逗号分隔）
ADMIN_USER_IDS=123456789,987654321

# ==================== Bot Pool 负载均衡配置 ⭐ 高可用 ====================

# 是否启用Bot Pool模式（多机器人负载均衡）
# true = 启用Bot Pool（从数据库bot_configs表加载所有bot）
# false = 传统单Bot模式（使用上面的BOT_TOKEN）
ENABLE_BOT_POOL=false

# Redis配置（Bot Pool必需）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Bot Pool策略
# least_connections = 最少连接策略（推荐）
# weighted_random = 加权随机策略
# priority_based = 优先级策略
BOT_POOL_STRATEGY=least_connections

# 健康检查配置
HEALTH_CHECK_INTERVAL=30      # 健康检查间隔（秒）
HEARTBEAT_TIMEOUT=60          # 心跳超时时间（秒）

# ⚠️ 使用Bot Pool模式步骤：
# 1. 设置 ENABLE_BOT_POOL=true
# 2. 启动Redis服务
# 3. 在管理后台 /admin/bot-pool 添加多个Bot Token
# 4. 系统将自动负载均衡，用户随机分配到不同bot
# 5. 支持动态添加/删除bot，无需重启

# ==================== 数据库配置 ====================

# SQLite数据库路径（当前版本仅支持SQLite）
DATABASE_PATH=data/bot.db
# ⚠️ 注意：系统使用轻量级SQLite数据库（零配置）
# 如需MySQL支持，请提交Issue或贡献代码

# API服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# TGAPI接码配置 ⭐ 重要
TGAPI_BASE_URL=https://api.yourdomain.com
# 如果使用HTTP: TGAPI_BASE_URL=http://yourdomain.com:8000
# 本地测试: TGAPI_BASE_URL=http://localhost:8000
# 此URL用于生成接码链接，客户端将访问: {TGAPI_BASE_URL}/api/code/{token}

TGAPI_DEFAULT_EXPIRE_HOURS=24
TGAPI_DEFAULT_MAX_LOGIN=-1

# ==================== Web管理后台配置 ⭐ 重要 ====================

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ⚠️ 生产环境请立即修改默认密码！

# Session密钥（用于加密Session）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your_secret_key_here_change_in_production

# Session过期时间（小时）
SESSION_TIMEOUT_HOURS=24

# 防爆破登录配置 ⭐ 安全重要
MAX_LOGIN_ATTEMPTS=5           # 最大登录尝试次数（10分钟内）
LOCKOUT_DURATION_MINUTES=15    # 锁定时长（分钟）
ATTEMPT_WINDOW_MINUTES=10      # 统计时间窗口（分钟）

# 管理后台访问地址
# 访问: http://yourdomain.com:8000/admin
# 本地: http://localhost:8000/admin

# 许可证配置（用于反盗版）
LICENSE_MAX_DEVICES=3

# ==================== Redis配置（Bot Pool必需） ====================

# Redis配置说明：
# - Bot Pool模式需要Redis进行负载均衡和会话管理
# - 单Bot模式可以不启用Redis
# REDIS_ENABLED=false  # 此配置项已废弃，由ENABLE_BOT_POOL控制
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# ⚠️ Redis配置已在上方"Bot Pool配置"部分定义

# ==================== 代理配置（可选） ====================

# 是否启用代理（false = 直连模式）
PROXY_ENABLED=false

# 代理通过管理后台动态添加，无需在此配置
# 访问管理后台 → 代理管理 → 添加代理

# ==================== 备份配置 ====================

BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
